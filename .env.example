# Export these variables before starting the service. This file is not auto-loaded.
OPENAI_API_KEY=your-provider-key
OPENAI_BASE_URL=https://api.openai.com/v1
REVIEW_MODEL=your-model-id
# Initial model; the UI can save a different model for reports and chat.
# REVIEW_MODEL may be omitted when you choose a model in the UI.

# Reports use JSON Schema structured output by default (supported by llama-server).
# Set to 0 only for providers without JSON Schema support. Restart after changes.
# REVIEW_LLM_STRUCTURED_OUTPUT=1

# Optional SOCKS5 proxy for reports, chat and model discovery. Restart after changes.
# REVIEW_LLM_PROXY=socks5://127.0.0.1:1080
# REVIEW_LLM_PROXY=socks5h://user:password@127.0.0.1:1080
# Percent-encode special characters in credentials, e.g. @ as %40 and : as %3A.

# Each report request attempt, including the response stream, may take this long.
# A JSON repair gets a separate attempt; transport retries are disabled by default.
# REVIEW_LLM_TIMEOUT_SECONDS=600
# REVIEW_LLM_MAX_RETRIES=0
# REVIEW_MAX_CONTEXT_CHARS=100000
# REVIEW_MAX_OUTPUT_TOKENS=8192

# Optional; otherwise a private token is generated in the state directory.
# REVIEW_TOKEN=use-a-long-random-token

# Optional OpenCode HTTP server (run: opencode serve --hostname 127.0.0.1).
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=your-server-password
